{
  "type": "module",
  "name": "web-features-explorer",
  "description": "Visualize web features",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@mdn/browser-compat-data": "^8.1.9",
    "@schalkneethling/opengraph-cards-maker": "^0.3.0",
    "apexcharts": "^8.8.1",
    "browser-specs": "^5.3.0",
    "caniuse-lite": "^1.0.30001826",
    "glob": "^14.0.6",
    "pagefind": "^1.6.0",
    "rimraf": "^6.1.4",
    "web-features": "next",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "npx rimraf docs && npx @11ty/eleventy && node generate-og-images.js",
    "build:search": "npm run build && npm run pagefind",
    "serve": "npx @11ty/eleventy --serve",
    "pagefind": "npx pagefind --site docs --glob \"features/**/*.html\""
  }
}

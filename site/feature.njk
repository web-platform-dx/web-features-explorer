---
layout: layout.njk
pagination:
  data: allFeatures
  size: 1
  alias: feature
permalink: "features/{{ feature.id | slugify }}/"
eleventyComputed:
  title: "{{ feature.name | safe }}"
  socialTitle: "{{ feature.name | safe }} - Web platform features explorer"
  socialDescription: "{{ feature.description | safe }}"
  socialImage: "{{ siteConfig.url }}assets/og/features/{{ feature.id | slugify }}.png"
  canonicalUrl: "{{ siteConfig.url }}features/{{ feature.id | slugify }}/"
---

<main class="feature-page">
  {% include "feature_full.njk" %}
</main>

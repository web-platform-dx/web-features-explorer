---
siteTitle: Web platform features explorer
---
{% set pageTitle = siteTitle + " - " + title %}
{% set defaultDescription = "Use the Web platform features explorer to discover new features and APIs and stay up-to-date with changes." %}
{% set defaultSocialImage = siteConfig.url + "assets/og/default.png" %}
{% set socialTitleText = socialTitle or pageTitle %}
{% set socialDescriptionText = socialDescription or defaultDescription %}
{% set socialImageUrl = socialImage or defaultSocialImage %}
{% set canonicalUrlText = canonicalUrl or siteConfig.url %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ pageTitle }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ socialDescriptionText }}">
    <link rel="canonical" href="{{ canonicalUrlText }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ siteTitle }}">
    <meta property="og:title" content="{{ socialTitleText }}">
    <meta property="og:description" content="{{ socialDescriptionText }}">
    <meta property="og:image" content="{{ socialImageUrl }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="{{ canonicalUrlText }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ socialTitleText }}">
    <meta name="twitter:description" content="{{ socialDescriptionText }}">
    <meta name="twitter:image" content="{{ socialImageUrl }}">
    <link rel="stylesheet" type="text/css" href="/assets/styles.css">
    {% if stylesheet %}
      <link rel="stylesheet" type="text/css" href="{{ stylesheet }}">
    {% endif %}
    {% if baselineStatusScript %}
      <script src="/assets/baseline-status.min.js" type="module"></script>
      {# Toggle fallback browser-support visibility after baseline-status loads. #}
      <script type="module">
        if ("customElements" in window) {
          customElements.whenDefined("baseline-status").then(() => {
            document.documentElement.classList.add("baseline-status-defined");
          });
        }
      </script>
    {% endif %}
    <link href="/assets/favicon.png" rel="icon" sizes="64x64" type="image/png">
    <link rel="alternate" type="application/atom+xml" title="Baseline newly available features" href="/newly-available.xml">
    <link rel="alternate" type="application/atom+xml" title="Baseline widely available features" href="/widely-available.xml">
    <link rel="alternate" type="application/atom+xml" title="Web platform release notes" href="/release-notes.xml">
  </head>
  <body>

    {% if not hideHeader %}
      <header>
        <a href="/">{{ siteTitle }}</a>

        <nav>
          <ul>
            <li><a href="/release-notes/{{ perMonth[0].date | slugify }}">Release notes</a></li>
            <li><a href="/newly-available">Explore features</a></li>
            <li><a href="/about">About</a></li>
          </ul>
          <search>
            <form>
              <input type="search" id="search" placeholder="Search">
            </form>
          </search>
        </nav>

        <output for="search"></output>
      </header>
    {% endif %}

    {{ content | safe }}

    {% if not hideHeader %}    
      <script src="/assets/search.js" defer></script>
    {% endif %}
  </body>
</html>

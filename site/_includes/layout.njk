{% set pageTitle = "Web features explorer - " + title %}
{% set defaultDescription = "Use the web features explorer to discover new features and APIs and stay up-to-date with changes." %}
{% set defaultSocialImage = siteConfig.url + "assets/og/default.png" %}
{% set socialTitleText = socialTitle or pageTitle %}
{% set socialDescriptionText = socialDescription or defaultDescription %}
{% set socialImageUrl = socialImage or defaultSocialImage %}
{% set canonicalUrlText = canonicalUrl or siteConfig.url %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ pageTitle }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ socialDescriptionText }}">
    <link rel="canonical" href="{{ canonicalUrlText }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Web features explorer">
    <meta property="og:title" content="{{ socialTitleText }}">
    <meta property="og:description" content="{{ socialDescriptionText }}">
    <meta property="og:image" content="{{ socialImageUrl }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="{{ canonicalUrlText }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ socialTitleText }}">
    <meta name="twitter:description" content="{{ socialDescriptionText }}">
    <meta name="twitter:image" content="{{ socialImageUrl }}">
    <link rel="stylesheet" type="text/css" href="/assets/styles.css">
    {% if stylesheet %}
      <link rel="stylesheet" type="text/css" href="{{ stylesheet }}">
    {% endif %}
    <link href="https://web-platform-dx.github.io/assets/img/webdx-notext.svg" rel="icon" type="image/svg+xml">
    <link rel="alternate" type="application/atom+xml" title="Baseline newly available features" href="/newly-available.xml">
    <link rel="alternate" type="application/atom+xml" title="Baseline widely available features" href="/widely-available.xml">
    <link rel="alternate" type="application/atom+xml" title="Web platform release notes" href="/release-notes.xml">
  </head>
  <body>

    {% if not hideHeader %}
      <header>
        <a href="/" class="logo-text">Web features <span>explorer</span></a>

        <search>
          <form>
            <input type="search" id="search" placeholder="Search for features">
          </form>
        </search>
        <output for="search"></output>

        <nav>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/release-notes/{{ perMonth[0].date | slugify }}">Release notes</a></li>
            <li><a href="/about">About</a></li>

            <li class="section-header">Features</li>
            
            <li><a href="/newly-available">Newly available</a></li>
            <li><a href="/widely-available">Widely available</a></li>
            <li><a href="/limited-availability">Limited availability</a></li>
            <li><a href="/discouraged">Discouraged</a></li>
            <li><a href="/opposed">Opposed</a></li>
            <li><a href="/most-wanted">Most wanted</a></li>
            <li><a href="/features">All features</a></li>

            <li class="section-header">Missing only in</li>
            
            {% for engineName, engineFeatures in missingOnlyInOneEngine %}
              <li><a href="/missing-only-in/{{ engineName | slugify }}/">{{ engineName }}</a></li>
            {% endfor %}

            <li class="section-header">Implemented only in</li>

            {% for engineName, engineFeatures in onlyInOneEngine %}
              <li><a href="/only-in/{{ engineName | slugify }}/">{{ engineName }}</a></li>
            {% endfor %}

            <li class="section-header">Features in latest releases</li>
  
            {% for browser in browsers %}
              <li>
                <a href="/browsers/{{ browser.id | slugify }}/">
                  {{ browser.name }}
                  {% for release in browser.releases %}
                    {% if release.status == "current" %}
                      {{ release.version }}
                    {% endif %}
                  {% endfor %}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      </header>

      <button class="menu-toggle" aria-label="Toggle menu">
        <span class="logo-text">Web features <span>explorer</span></a>
      </button>
      <script>
        const menuToggle = document.querySelector(".menu-toggle");
        const header = document.querySelector("header");
        menuToggle.addEventListener("click", () => {
          header.classList.toggle("open");
        });
      </script>
    {% endif %}

    {{ content | safe }}

    {% if not hideHeader %}    
      <script src="/assets/search.js" defer></script>
    {% endif %}
  </body>
</html>
